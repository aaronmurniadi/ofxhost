# One style for every editor, so a diff shows a change and not a reformat.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.{c,h,cpp,hpp,mm}]
indent_style = space
indent_size = 2

[*.md]
# A Markdown line break is two trailing spaces, so they are kept here.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
