# Wails
.task/
.wails/
bin/

# Go
/ofxhost

# The native OpenFX host library, built by CMake from the submodule. It is an
# artefact, not source: the build instructions are in README.md.
/build/
*.test
*.out

# Frontend
frontend/node_modules/
frontend/bindings/
# The built frontend is an artefact. The .gitkeep keeps the directory present,
# because go:embed needs a non-empty directory to compile.
frontend/dist/*
!frontend/dist/.gitkeep

# Editor and OS noise
.DS_Store
.pi/
.pi-lens.json
.pi-web/
